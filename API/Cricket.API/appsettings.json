{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": { "Default": "Error" },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/CricketAPI-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3} {Message:lj}{Exception}{NewLine}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ApiInfo": { "Version": "1.0.0" },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=CricketDB;User=YOUR_USER;Password=SET_VIA_USER_SECRETS;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "FirebaseConfig": {
    "ProjectId": "cricket-run-notification",
    "CredentialsPath": "firebase-service-account.json"
  },
  "AppConfig": {
    "MinAppVersion": "1.0.0",
    "Features": { "sharing": true },
    "PublicBaseUrl": ""
  },
  "AllowedOrigins": []
}
