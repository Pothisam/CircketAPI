<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the Cricket API. `dotnet publish` keeps this file and fills in the aspNetCore
  process settings (processPath / arguments / hosting model).

  Why the <remove> entries: IIS's WebDAV module/handler answers PUT, PATCH and DELETE itself with
  "405 - HTTP verb used to access this page is not allowed", so those requests never reach the API
  (the app then only sees "Failed to fetch"). The API needs every verb.
-->
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <remove name="aspNetCore" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
  </system.webServer>
</configuration>
